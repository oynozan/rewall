# Copy this file to .env and fill it in. .env is gitignored.

# Twelve words. Every example derives its wallets from this one phrase.
# Use a throwaway phrase. Never one that holds real money.
REWALL_MNEMONIC=

# Optional. Defaults to a free public endpoint if you leave it blank.
SEPOLIA_RPC_URL=

# Examples 6 and 7 need a private transfer rail. See rail/README.md to start one,
# then copy the three values it prints here.
RAIL_API=http://127.0.0.1:8788
VAULT_ADDRESS=
TOKEN_ADDRESS=
