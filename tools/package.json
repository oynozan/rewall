{
    "name": "@rewall/tools",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@9.12.2",
    "scripts": {
        "wallets": "node --env-file=.env --experimental-strip-types wallets.ts",
        "bootstrap": "node --env-file=.env --experimental-strip-types bootstrap.ts",
        "deploy": "node --env-file=.env --experimental-strip-types deploy.ts",
        "verify": "node --env-file=.env --experimental-strip-types verify.ts",
        "status": "node --env-file=.env --experimental-strip-types status.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "identity": "node --env-file=.env --experimental-strip-types identity.ts",
        "secret": "node --env-file=.env --experimental-strip-types secret.ts",
