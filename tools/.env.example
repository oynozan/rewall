# Sepolia RPC. publicnode is the only free endpoint serving eth_simulateV1.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Funds the test wallets. Testnet only, never a phrase or key with mainnet value.
REWALL_FUNDER_KEY=

# Derives every test identity at a fixed index. Generated by scripts/wallets.ts.
REWALL_TEST_MNEMONIC=
