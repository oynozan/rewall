# A hosted server needs none of this. Every caller sends X-Rewall-Vault and X-Rewall-Seed, and the
# process keeps no identity of its own. Leave both of the first two blank for that mode.
#
# Set them to run this for one agent, locally over stdio or as your own single tenant deployment.
# Then the key never leaves your machine and callers send no headers at all.

# The ENS name this agent acts as. Its rewall.pubkey must be published, and secrets are
# granted to this name by their owner.
REWALL_NAME=

# The agent's X25519 identity seed, base64, 32 bytes. This is the whole capability the
# server needs, so a host holding one can decrypt what was granted to this name and nothing
# else. It cannot sign, spend gas, write ENS records or forge an authorization.
#
# `pnpm run agent <your-vault.eth> <label>` mints a fresh one under a name you own, which is
# what belongs on any host you do not control. `pnpm run seed` derives one from a wallet key
# instead, which gives that wallet's whole identity and belongs only on a machine you own.
# Injecting it at process start (systemd LoadCredential, a Docker secret, CI OIDC) keeps it
# out of the environment and off disk.
REWALL_IDENTITY_SEED=

# The wallet key, only needed to derive the seed above the first time. Leave it unset on any
# host you do not own. If both are set the seed wins.
REWALL_AGENT_KEY=

# The wallet that owns the vault, used only by `pnpm run agent` to publish a new agent's key.
# It never reaches the server. One of the two is enough.
REWALL_OWNER_KEY=
REWALL_OWNER_MNEMONIC=

# Optional, defaults to the public node.
SEPOLIA_RPC_URL=

# Networked server only, all optional.
#
# REWALL_MCP_HOST     which interface to bind, 127.0.0.1 unless a proxy or a container needs otherwise
# REWALL_TRUST_PROXY  set to 1 behind a reverse proxy, so X-Forwarded-Proto is believed about TLS
# REWALL_ALLOWED_HOSTS  the Host values to accept, which is what stops DNS rebinding
# REWALL_SHARED_VAULT set to 1 to answer any caller sending no headers as the vault above
# REWALL_SIGNING      set to 1 to offer sign_with_secret, which needs policy.json and the vault above
# REWALL_RPM          requests a minute per identity, 120 by default
# REWALL_PEER_RPM     requests a minute per peer address, 240 by default
