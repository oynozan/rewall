# The ENS name this agent acts as. Its rewall.pubkey must be published, and secrets are
# granted to this name by their owner.
REWALL_NAME=

# The agent's own key. It derives the X25519 identity that unseals secrets granted to
# REWALL_NAME and is never used to sign anything else.
#
# This server builds no walletClient and no account, so every write path in the SDK refuses.
# Injecting this at process start (systemd LoadCredential, a Docker secret, CI OIDC) keeps it
# out of the environment and off disk, which is worth doing on any host you do not own.
REWALL_AGENT_KEY=

# Optional, defaults to the public node.
SEPOLIA_RPC_URL=
