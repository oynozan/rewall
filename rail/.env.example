# Twelve word phrase the wallets derive from, the same one tools/ and examples/ use
REWALL_TEST_MNEMONIC=

# Sepolia endpoint, the public node is the one that serves eth_simulateV1
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Circle's Sepolia USDC, six decimals. Any registered ERC-20 works, the vault is not tied to this one
TOKEN_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Written by pnpm run deploy, copy them here afterwards
VAULT_ADDRESS=
POLICY_ENGINE=

# Interface the server listens on, loopback keeps every balance in this process off the network
RAIL_HOST=127.0.0.1

# Blocks to wait before a deposit credits, raise it to reproduce the real service's finality delay
CONFIRMATIONS=1

# Wallet index that deploys, keep it off any account another process uses
DEPLOYER_INDEX=0
