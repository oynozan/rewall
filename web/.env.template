NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
PRIVY_APP_SECRET=
PRIVY_TEST_WALLET_ID=

NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_REWALL_MOCKS=

# Server only, never prefixed with NEXT_PUBLIC. Its own wallet, not the funder in tools/.env,
# because this one is reachable from the internet and the funder is not.
REWALL_SPONSOR_KEY=
MONGODB_URI=mongodb://127.0.0.1:27017
REWALL_DRIP_ETH=0.005
REWALL_FAUCET_CAP_ETH=0.05
REWALL_PROVISION_CAP=25

# The rail's vault, printed by pnpm run deploy in rail/. Public because the browser signs against it
# as the EIP-712 verifyingContract. Left blank the SDK falls back to Chainlink's deployment, which
# authenticates and credits nothing, so src/lib/rail.ts throws rather than look healthy and stay empty.
# The token is Circle's Sepolia USDC, a fixed address in src/lib/rail.ts rather than a setting.
NEXT_PUBLIC_REWALL_VAULT=

# Where /api/rail forwards to. Never NEXT_PUBLIC, the browser has no business knowing where it lives.
# Written as the IPv4 literal because Node resolves localhost to IPv6 first and the rail binds IPv4.
REWALL_RAIL_URL=http://127.0.0.1:8787

# USDC the faucet hands a new wallet and the total it may ever hand out, in whole tokens.
# Nothing can mint Circle's USDC, so the sponsor's balance is whatever a human sent it.
REWALL_USDC_DRIP=1
REWALL_USDC_CAP=100
