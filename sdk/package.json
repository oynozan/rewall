{
    "name": "@rewall/sdk",
    "version": "0.1.0",
    "description": "Encrypt a secret on your device and store it under an ENS name you own, readable only by the names it was sealed to",
    "homepage": "https://docs.rewall.me",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oynozan/rewall.git",
        "directory": "sdk"
    },
    "keywords": [
        "ens",
        "ensv2",
        "secrets",
        "encryption",
        "x25519",
        "libsodium",
        "viem",
        "ethereum"
    ],
    "type": "module",
    "packageManager": "pnpm@9.12.2",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./2fa": {
            "types": "./dist/2fa.d.ts",
            "default": "./dist/2fa.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "prepublishOnly": "pnpm run build && pnpm test",
        "build": "tsc -b",
        "test": "node --experimental-strip-types --test src/*.test.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "libsodium-wrappers": "^0.8.4",
        "otpauth": "^9.5.2",
        "shamir-secret-sharing": "^0.0.4",
        "viem": "^2.56.3"
    },
    "devDependencies": {
        "@types/node": "^22.20.2",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2"
    }
}
