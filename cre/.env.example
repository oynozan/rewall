###############################################################################
### Copy to `.env`, which is gitignored. Do not share it.                   ###
###############################################################################
# Default target used when --target is not passed
CRE_TARGET=staging-settings
# The enclave's X25519 scalar as 64 lowercase hex characters, written by provision.ts.
# The workflow fetches it with runtime.getSecret({ id: 'ENCLAVE_SCALAR' }).
SECRET_ENCLAVE_SCALAR=
