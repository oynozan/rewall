{
    "name": "@rewall/extension",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@9.12.2",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --warnings-as-errors -o text",
        "postinstall": "wxt prepare",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "node scripts/check-otp-fields.mjs"
    },
    "devDependencies": {
        "@types/chrome": "^0.2.9",
        "esbuild": "^0.28.2",
        "playwright": "^1.63.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "web-ext": "^10.6.0",
        "wxt": "^0.21.4"
    }
}
